# Runtime connection: hotel_app role, row-level security enforced.
DATABASE_URL="postgresql://hotel_app:hotel_app_dev@localhost:5432/hotel_dev"
# Migrations, seed and platform scripts: hotel_admin role (owns tables, bypasses RLS).
DATABASE_ADMIN_URL="postgresql://hotel_admin:hotel_admin_dev@localhost:5432/hotel_dev"

# Test database (used by `pnpm test`)
TEST_DATABASE_URL="postgresql://hotel_app:hotel_app_dev@localhost:5432/hotel_test"
TEST_DATABASE_ADMIN_URL="postgresql://hotel_admin:hotel_admin_dev@localhost:5432/hotel_test"
