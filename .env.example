# Runtime connection: hotel_app role, row-level security enforced.
DATABASE_URL="postgresql://hotel_app:hotel_app_dev@localhost:5432/hotel_dev"
# Migrations, seed and platform scripts: hotel_admin role (owns tables, bypasses RLS).
DATABASE_ADMIN_URL="postgresql://hotel_admin:hotel_admin_dev@localhost:5432/hotel_dev"

# Test database (used by `pnpm test`)
TEST_DATABASE_URL="postgresql://hotel_app:hotel_app_dev@localhost:5432/hotel_test"
TEST_DATABASE_ADMIN_URL="postgresql://hotel_admin:hotel_admin_dev@localhost:5432/hotel_test"

# Encrypts staff authenticator secrets (AES-256-GCM). 32 random bytes, base64.
# DEV ONLY — generate a new one for every real environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY="IM7Cuyw7JRXQiMoLp3+8Ds5+M0xolZZrFxjNhBWf9EQ="

# Public origin used to build guest QR links (no trailing slash). Required in production.
APP_ORIGIN="http://localhost:3000"

# Bearer secret for the alert job route (M4). The scheduler sends "Authorization: Bearer <secret>".
# Without it the route refuses every call. Generate one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ALERT_JOB_SECRET=""

# Web push for supervisor alerts (M4). Leave empty to turn push off; alerts still show in the app.
# Generate a key pair once per environment:  pnpm exec web-push generate-vapid-keys
# VAPID_SUBJECT is a contact the push services can reach, e.g. mailto:ops@your-hotel.example
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""
